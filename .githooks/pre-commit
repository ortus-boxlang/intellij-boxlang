#!/usr/bin/env bash
set -euo pipefail

# Allow bypass when necessary, e.g. SKIP_SPOTLESS_PRECOMMIT=1 git commit ...
if [[ "${SKIP_SPOTLESS_PRECOMMIT:-}" == "1" ]]; then
  exit 0
fi

staged_java_files=()
while IFS= read -r file; do
  if [[ -n "${file}" ]]; then
    staged_java_files+=("${file}")
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.java')

if [[ ${#staged_java_files[@]} -eq 0 ]]; then
  exit 0
fi

spotless_files=""
for file in "${staged_java_files[@]}"; do
  if [[ -z "${spotless_files}" ]]; then
    spotless_files="${file}"
  else
    spotless_files="${spotless_files},${file}"
  fi
done

echo "Running Spotless on staged Java files..."
./gradlew -q spotlessApply -PspotlessFiles="${spotless_files}"

# Re-stage only files the hook formatted.
git add -- "${staged_java_files[@]}"
