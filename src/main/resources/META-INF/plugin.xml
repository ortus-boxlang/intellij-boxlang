<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
  <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
  <id>com.ortussolutions.intellij-boxlang</id>

  <!-- Public plugin name should be written in Title Case.
       Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-name -->
  <name>BoxLang IDE</name>

  <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
  <vendor url="https://www.ortussolutions.com">Ortus Solutions</vendor>

  <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
       Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-description -->
  <description>BoxLang IDE Plugin for IntelliJ IDEA providing Syntax Highlighting and LSP integration</description>

  <!-- Product and plugin compatibility requirements.
       Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.lang</depends>

  <!-- Extension points defined by the plugin.
       Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
  <extensions defaultExtensionNs="com.intellij">

    <fileType
      name="BoxLang"
      language="BoxLang"
      extensions="bx;bxm;bxs"
      implementationClass="com.ortussolutions.intellijboxlang.file.BoxLangFileType" />

    <lang.syntaxHighlighterFactory
      language="BoxLang"
      implementationClass="com.ortussolutions.intellijboxlang.highlighting.BoxLangSyntaxHighlighterFactory" />

    <colorSettingsPage implementation="com.ortussolutions.intellijboxlang.highlighting.BoxLangColorSettingsPage" />

    <projectConfigurable
      id="boxlang.project.settings"
      displayName="BoxLang"
      groupId="language"
      instance="com.ortussolutions.intellijboxlang.settings.BoxLangProjectConfigurable" />

  </extensions>

  <actions>
    <action
      id="BoxLang.NewFile"
      class="com.ortussolutions.intellijboxlang.actions.BoxLangCreateFileAction"
      text="BoxLang File"
      description="Create a BoxLang file">
      <add-to-group group-id="NewGroup" anchor="last" />
    </action>
  </actions>
</idea-plugin>
